rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone can read, only authenticated users can write their own
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User data (trial, heartCodes, friends): only owner can read/write
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
